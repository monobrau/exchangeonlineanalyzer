# Copy to .env and adjust. All vars use EOA_ prefix (see app/config.py).

# EOA_DEBUG=false
# EOA_CORS_ORIGINS=https://your.domain,http://localhost:8080
# EOA_USE_PWSH_STUB_WORKER=true
# EOA_PWSH_PATH=pwsh
# Optional: script name under web/pwsh/ (default WebBulkJobStub.ps1)
# EOA_PWSH_WORKER_SCRIPT=WebBulkJobStub.ps1
# EOA_OIDC_ISSUER=https://auth.knospe.org/application/o/eoa/
# EOA_OIDC_CLIENT_ID=
# EOA_OIDC_AUDIENCE=  # optional; defaults to EOA_OIDC_CLIENT_ID (Authentik JWT aud)
# Browser login (PKCE) — register this exact redirect URI in Authentik
# EOA_OIDC_CLIENT_SECRET=
# EOA_OIDC_REDIRECT_URI=http://127.0.0.1:8080/api/v1/auth/oidc/callback
# EOA_SESSION_SECRET=long-random-string
# Optional: EOA_OIDC_AUDIENCES=id1,id2
# EOA_REPO_ROOT=/home/cknospe/git/exchangeonlineanalyzer
#
# Microsoft sign-in in browser (MSAL) — Entra app: SPA platform, same redirect URI as this page (/ or /app)
# EOA_MS_GRAPH_SPA_CLIENT_ID=
# EOA_MS_GRAPH_TENANT=organizations
#
# Python Graph worker (app-only, many tenants): EOA_GRAPH_CLIENT_ID + EOA_GRAPH_CLIENT_SECRET + EOA_USE_PYTHON_GRAPH_WORKER=true
# EOA_GRAPH_MAX_TENANTS_PER_JOB=300
