# Example: reverse-proxy the API (and optionally serve TLS at nginx).
# Adjust server_name and paths; include inside a server { } block.
#
# After UI deploys, avoid caching HTML/JS at the edge:
#   proxy_cache off;  (or location = /app { proxy_cache off; ... })
# Cloudflare: set "Cache Level: Bypass" for /app and optionally /static/*.js

location / {
    proxy_pass http://127.0.0.1:18080;  # uvicorn; webhost uses 8080 for blingus nginx
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 3600s;
    client_max_body_size 50m;
}
