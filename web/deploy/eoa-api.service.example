# Copy to /etc/systemd/system/eoa-api.service and adjust User/WorkingDirectory/Environment.
# sudo systemctl daemon-reload && sudo systemctl enable --now eoa-api

[Unit]
Description=Exchange Online Analyzer Web API (FastAPI)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=cknospe
Group=cknospe
WorkingDirectory=/home/cknospe/git/exchangeonlineanalyzer/web
Environment=PATH=/home/cknospe/git/exchangeonlineanalyzer/web/.venv/bin:/usr/local/bin:/usr/bin
EnvironmentFile=-/home/cknospe/git/exchangeonlineanalyzer/web/.env
# Port 18080: nginx uses 127.0.0.1:8080 (blingus). Use 0.0.0.0 so LAN can test; restrict with host firewall (e.g. ufw allow 18080/tcp from LAN only).
ExecStart=/home/cknospe/git/exchangeonlineanalyzer/web/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 18080
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
