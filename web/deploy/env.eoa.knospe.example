# Copy to web/.env on webhost when serving at https://eoa.knospe.org
# Full Authentik steps: deploy/authentik-eoa.md

EOA_OIDC_ISSUER=https://auth.knospe.org/application/o/eoa/
EOA_OIDC_CLIENT_ID=
# Usually same as client id (JWT aud). Required for API to accept the access token.
EOA_OIDC_AUDIENCE=
EOA_OIDC_REDIRECT_URI=https://eoa.knospe.org/api/v1/auth/oidc/callback
# Public PKCE client: leave empty. Confidential: set to match Authentik.
# EOA_OIDC_CLIENT_SECRET=
EOA_CORS_ORIGINS=https://eoa.knospe.org
EOA_SESSION_SECRET=replace-with-long-random-string
# EOA_REPO_ROOT=/home/cknospe/git/exchangeonlineanalyzer
# EOA_USE_PWSH_STUB_WORKER=true
